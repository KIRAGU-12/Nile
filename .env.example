# ─── Nile — environment configuration ───────────────────────────────
# This is the reference list of variables to set on RENDER.
# For local dev: copy this file to .env.local and fill in your real values.
# For production: paste the values into Render → Project → Environment.

# ═══ REQUIRED — paste these into Render ═════════════════════════════

# Supabase project (used for BOTH the database and authentication)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-anon-key
SUPABASE_SECRET_KEY=your-secret-key            # server-only: never expose to the browser

# AI assistant — DeepSeek (powers Nile chat + practice-quiz grading)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_CHAT_MODEL=deepseek-chat

# ═══ OPTIONAL / NOT used by the app today ═══════════════════════════
# OpenAI-compatible endpoint — kept for future use; the app currently uses DeepSeek.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

NEXT_PUBLIC_BASE_URL=

# ═══ LOCAL ONLY — not needed on Render ══════════════════════════════
# Direct Postgres connection (used to provision tables via scripts/setup-supabase.mjs)
DATABASE_URL=postgresql://postgres.your-ref:password@aws-1-region.pooler.supabase.com:6543/postgres

# ═══ MANAGED BY RENDER (no need to add) ═════════════════════════════
# NODE_VERSION=22     (set in render.yaml)
# NODE_ENV=production
# PORT                (injected automatically — used by the start command)
